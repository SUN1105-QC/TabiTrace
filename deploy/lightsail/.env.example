# Copy only on the server to /srv/sunows/apps/tabi/shared/.env (mode 0600).
# Do not commit actual credentials. Run prepare.sh to generate DB/JWT secrets.
APP_URL=https://tabi.sunows.com
RELEASE_TAG=local
MYSQL_DATA_DIR=/srv/sunows/data/mysql/tabi
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_MUSIC_BUCKET=
R2_PUBLIC_BASE_URL=
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Owner-approved video budgets (2026-10-29). Set enforce=false for observation-only mode.
COST_ENFORCE=true
COST_ACCOUNT_DAILY_RENDERS=20
COST_ACCOUNT_DAILY_SECONDS=6000
COST_GLOBAL_DAILY_RENDERS=0
COST_GLOBAL_DAILY_SECONDS=0
COST_GLOBAL_ACTIVE_RENDERS=3
COST_WARN_DAILY_RENDERS=20
COST_WARN_DAILY_SECONDS=1200
COST_WARN_GLOBAL_DAILY_RENDERS=200
COST_WARN_GLOBAL_DAILY_SECONDS=12000
COST_WARN_STORAGE_BYTES=10737418240
VIDEO_OUTPUT_CLEANUP_INTERVAL_MS=60000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_API_KEY=
