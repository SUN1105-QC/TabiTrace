# Limits approved by the owner on 2026-10-29.
# Enabling protection with every limit set to 0 fails startup.
# Copy the chosen lines into the existing private server env file; do not overwrite DB/Stripe secrets.
COST_ENFORCE=true

# Daily limits use UTC dates; active tasks include both QUEUED and PROCESSING.
COST_ACCOUNT_DAILY_RENDERS=20
COST_ACCOUNT_DAILY_SECONDS=6000
COST_GLOBAL_ACTIVE_RENDERS=3

# Optional all-site daily budgets. 0 means unlimited.
COST_GLOBAL_DAILY_RENDERS=0
COST_GLOBAL_DAILY_SECONDS=0

# Storage remains observation-only because current totals are estimates, not an object inventory.
# Never invent a hard storage cap from COST_WARN_STORAGE_BYTES.
