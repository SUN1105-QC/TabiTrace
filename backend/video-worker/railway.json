{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/video-worker/Dockerfile",
    "watchPatterns": ["backend/pom.xml", "backend/video-worker/**"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 35
  }
}
