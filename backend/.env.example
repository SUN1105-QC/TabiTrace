# ─────────────────────────────────────────────────────────────
# TabiTrace API / Video Worker 环境变量（只写变量名与占位值，不要写真实密钥）
# 本地开发：复制为 .env 后按需修改；生产（Railway）：在服务的 Variables 里配置
# SPRING_PROFILES_ACTIVE=prod 时，缺失或仍是开发默认值会直接启动失败（只报变量名，不输出值）
# ─────────────────────────────────────────────────────────────

# 运行环境：local（默认）/ prod
SPRING_PROFILES_ACTIVE=local
# 监听端口：Railway 自动注入 PORT；本地用 SERVER_PORT（默认 8080）
# PORT=
SERVER_PORT=8080

# ── 数据库（MySQL 8）──
# Railway（私网，不要把密码写进 URL）：jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&sslMode=PREFERRED&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://localhost:3306/tabitrace?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=tabitrace_app
DB_PASSWORD=tabitrace_dev
DB_POOL_SIZE=10

# ── 登录 ──
# 至少 32 字节随机值（openssl rand -base64 48）；prod 拒绝 change-me 或过短的值
JWT_SECRET=tabitrace-dev-secret-change-me-32bytes-minimum
# refresh token Cookie 是否 Secure（prod 配置文件里固定为 true）
AUTH_COOKIE_SECURE=false
# API 只能经由可信代理访问（Railway 私网 + 前端同源代理）时设为 true，按 X-Forwarded-For 最右侧取客户端 IP
TRUST_PROXY_HEADERS=false

# ── 站点地址 ──
# 正式站点地址（https），用于邮件、分享链接与支付回跳
APP_PUBLIC_URL=http://localhost:3000
APP_API_URL=http://localhost:8080
# 只允许正式站点；prod 拒绝 * 与 localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 照片 / 头像 / 成片存储 ──
# local（本地磁盘，仅开发）/ r2（S3 兼容对象存储，生产必须）
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./.tabitrace/uploads
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# 存储桶公开访问地址（https，例如自定义域名 https://media.example.com）
R2_PUBLIC_BASE_URL=

# ── 支付 ──
# mock 仅限开发（模拟支付成功）；prod 固定为 stripe，未配置密钥时升级入口显示“支付暂未开放”
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── 邮件（注册 / 找回密码验证码）──
# smtp（默认）或 resend（HTTPS API，适用于不允许出站 SMTP 的平台，如 Railway 非 Pro 套餐）
MAIL_PROVIDER=smtp
RESEND_API_KEY=
# 本地默认 localhost:1025（backend/scripts/dev-mail-catcher.mjs）；生产使用真实 SMTP
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
# 必须是在邮件服务商验证过的发件地址
MAIL_FROM_ADDRESS=no-reply@tabitrace.local
MAIL_FROM_NAME=旅迹 TabiTrace

# ── Travel Story（视频生成）──
# 启动真实 video-worker 时必须为 false；prod 固定为 false
VIDEO_MOCK_RENDERER=true
VIDEO_PROCESSING_TIMEOUT_SECONDS=300
# 以下仅 video-worker 使用（Docker 镜像里已设置默认值）
FFMPEG_BINARY=ffmpeg
# 背景音乐：本地开发从本地存储目录读取（music-sync.mjs --publish-local 发布到这里）；生产从 R2 下载到缓存目录
VIDEO_MUSIC_DIR=../api/.tabitrace/uploads
WORKER_MUSIC_CACHE_DIR=
VIDEO_WORK_DIR=../../frontend/public/generated-videos
VIDEO_PUBLIC_BASE_URL=http://localhost:3000/generated-videos
WORKER_FFMPEG_TIMEOUT_SECONDS=600
WORKER_HEARTBEAT_SECONDS=15
