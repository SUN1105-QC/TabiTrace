DB_URL=jdbc:mysql://localhost:3306/tabitrace?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=tabitrace_app
DB_PASSWORD=tabitrace_dev
# prod profile 会拒绝包含 change-me 或短于 32 字节的密钥，生产环境请替换为随机值（如 openssl rand -base64 48）
JWT_SECRET=tabitrace-dev-secret-change-me-32bytes-minimum
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3000
STORAGE_MODE=local
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://localhost:3000
APP_API_URL=http://localhost:8080
LOCAL_STORAGE_DIR=./.tabitrace/uploads
# 启动真实 video-worker 时必须设为 false，否则 API 内置的模拟渲染器会与 Worker 争抢同一批 QUEUED 任务
VIDEO_MOCK_RENDERER=true
VIDEO_MUSIC_DIR=/opt/tabitrace/frontend/public/music
FFMPEG_BINARY=/usr/bin/ffmpeg
VIDEO_WORK_DIR=/opt/tabitrace/frontend/public/generated-videos
VIDEO_PUBLIC_BASE_URL=http://localhost:3000/generated-videos
# API：PROCESSING 任务超过这么多秒没有心跳就标记为「生成中断」（Worker 每 15 秒写一次心跳）
VIDEO_PROCESSING_TIMEOUT_SECONDS=300
# Worker：单次 FFmpeg 调用的硬超时（秒），防止进程卡死后心跳一直续命
WORKER_FFMPEG_TIMEOUT_SECONDS=600
WORKER_HEARTBEAT_SECONDS=15
# 邮件（SMTP）：注册邮箱验证码。本地默认 localhost:1025（backend/scripts/dev-mail-catcher.mjs），生产必须填写真实 SMTP
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
MAIL_FROM_ADDRESS=no-reply@tabitrace.local
MAIL_FROM_NAME=旅迹 TabiTrace
