# TabiTrace 前端环境变量（只写变量名与占位值）
# 注意：NEXT_PUBLIC_ 开头的变量会被打进浏览器代码，只能放公开值

# 生产：内网 API 地址（服务端转发用，不会暴露给浏览器），构建阶段就必须配置
# Railway：http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
# API_INTERNAL_URL=

# 浏览器访问 API 的地址。留空时：开发直连 http://localhost:8080/api/v1，生产使用同源 /api/v1（推荐）
# NEXT_PUBLIC_API_BASE_URL=

# 地图底图服务商（见 lib/map-tiles.ts）。开发环境全部留空时使用 OpenStreetMap 官方瓦片（仅限开发）；
# 生产环境必须配置其中一项，否则地图只显示标点（不会回退到 OSM 官方瓦片服务器）。
# 矢量样式 JSON（WebGL 地图），例如 MapTiler / Stadia / 自托管 PMTiles 的 style.json
NEXT_PUBLIC_MAP_STYLE_URL=
# 栅格瓦片模板（WebGL 与不支持 WebGL 的基础地图都能用），例如 https://tiles.example.com/{z}/{x}/{y}.png?key={key}
NEXT_PUBLIC_MAP_TILE_URL=
# 栅格瓦片的版权署名（HTML），按服务商许可填写，例如 &copy; 服务商 &copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_ATTRIBUTION=
# 可选：替换上面地址中的 {key}。会进入浏览器代码，只能用在服务商后台限制了域名的公开 key
NEXT_PUBLIC_MAP_API_KEY=
